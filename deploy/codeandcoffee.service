[Unit]
Description=Chicago Code and Coffee slides
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/codeandcoffee
Environment=HOST=127.0.0.1
Environment=PORT=8111
ExecStart=/root/.deno/bin/deno run --allow-net --allow-read --allow-env server.ts
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
